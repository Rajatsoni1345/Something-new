# ============================================================
# BIRTHDAY QUEST - ENVIRONMENT TEMPLATE
# ============================================================
#
# This file is SAFE to commit.
# NEVER put real secrets here.
#
# Copy this file to `.env` and fill in real values locally.
# Production values go into Render Environment settings.
# ============================================================


# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

APP_NAME=Birthday Quest
FLASK_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1


# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string


# ------------------------------------------------------------
# REQUEST LIMITS
# ------------------------------------------------------------

# 262144000 bytes = 250 MB
MAX_CONTENT_LENGTH=262144000


# ------------------------------------------------------------
# FRONTEND / CORS
# ------------------------------------------------------------

# Development:
FRONTEND_ORIGIN=http://localhost:3000

# Production (example):
# FRONTEND_ORIGIN=https://yourdomain.com


# ------------------------------------------------------------
# TRUSTED HOSTS
# ------------------------------------------------------------

TRUSTED_HOSTS=localhost,127.0.0.1


# ============================================================
# FIREBASE
# ============================================================
# Get these from:
#   Firebase Console → Project Settings → Service Accounts
#   → Generate new private key
#
# Then copy values from the downloaded JSON:
# ============================================================

FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=


# ============================================================
# CLOUDINARY
# ============================================================
# Get these from:
#   https://console.cloudinary.com/settings/api-keys
# ============================================================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ============================================================
# ADMIN ACCESS
# ============================================================
# Firebase UIDs of admin users (comma-separated).
# Get your UID from Firebase Authentication → Users.
# ============================================================

ADMIN_UIDS=
ADMIN_EMAILS=
