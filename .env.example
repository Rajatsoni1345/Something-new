# ============================================================
# BIRTHDAY QUEST - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
#
# IMPORTANT:
# This file is safe to commit to GitHub.
# NEVER put real passwords, API keys, private keys, or secrets
# in this file.
#
# Create a local .env file from this template for development.
# Production values will be configured separately on Render.
# ============================================================


# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

APP_NAME=Birthday Quest

# development | production
FLASK_ENV=development


# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------

# Replace this in your real .env file with a long random secret.
# NEVER use this example value in production.
SECRET_KEY=change-this-to-a-long-random-secret


# ------------------------------------------------------------
# API
# ------------------------------------------------------------

# Maximum incoming request size.
# 262144000 bytes = 250 MB
MAX_CONTENT_LENGTH=262144000


# ------------------------------------------------------------
# FRONTEND / CORS
# ------------------------------------------------------------

# Development frontend origin.
# This will later be changed to the real frontend domain.
FRONTEND_ORIGIN=http://localhost:3000


# ------------------------------------------------------------
# TRUSTED HOSTS
# ------------------------------------------------------------

TRUSTED_HOSTS=localhost,127.0.0.1


# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------

LOG_LEVEL=INFO


